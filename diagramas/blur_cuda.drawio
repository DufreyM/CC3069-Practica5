<mxfile host="app.diagrams.net">
  <diagram name="Blur CUDA">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Diagrama de flujo · Filtro de desenfoque 3×3 con CUDA (Host ↔ Device)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="laneH" value="Host (CPU · RAM)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=8;fillColor=#f8f9fb;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="560" height="1040" as="geometry"/>
        </mxCell>
        <mxCell id="laneD" value="Device (GPU · VRAM)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=8;fillColor=#fbf8fc;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="660" y="80" width="640" height="1040" as="geometry"/>
        </mxCell>
        <mxCell id="ini" value="Inicio" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="130" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="leer" value="Entrada: imagen I&lt;br&gt;H × W × 3 (uint8)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="190" y="210" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="h2d" value="d_I ← cuda.to_device(I)&lt;br&gt;cuda.synchronize()&lt;br&gt;&lt;i&gt;medir t_H2D&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="170" y="300" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="alloc" value="d_R ← cuda.device_array((H, W, 3), uint8)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="170" y="400" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="cfg" value="bloque ← (16, 16)&lt;br&gt;grid ← (⌈W / 16⌉, ⌈H / 16⌉)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="170" y="480" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="launch" value="blur_kernel[grid, bloque](d_I, d_R)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="170" y="570" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="sync" value="cuda.synchronize()&lt;br&gt;(espera a que terminen todos los hilos)&lt;br&gt;&lt;i&gt;medir t_kernel&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="170" y="650" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="d2h" value="R ← d_R.copy_to_host()&lt;br&gt;&lt;i&gt;medir t_D2H&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="170" y="750" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="speed" value="t_CUDA ← t_H2D + t_kernel + t_D2H&lt;br&gt;Speedup ← t_CPU / t_CUDA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="170" y="840" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="out" value="Salida: imagen R y tiempos" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=20;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="190" y="940" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="fin" value="Fin" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="1030" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="vin" value="VRAM: d_I&lt;br&gt;(copia de la entrada)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="870" y="290" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="vout" value="VRAM: d_R&lt;br&gt;(resultado)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="700" y="735" width="140" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="k0" value="blur_kernel: cada hilo" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="570" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="kidx" value="(x, y) ← cuda.grid(2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="930" y="650" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="kdec" value="¿x &amp;lt; W&lt;br&gt;y y &amp;lt; H?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="950" y="730" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="kno" value="Hilo sobrante:&lt;br&gt;no hace nada" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1190" y="750" width="100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="kloop" value="Para c = 0, 1, 2:&lt;br&gt;suma de la ventana 3×3 de d_I&lt;br&gt;(índices con clamp)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="910" y="860" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="kwr" value="d_R[y, x, c] ← redondear(suma / 9)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="910" y="960" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="kend" value="Fin del hilo" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="970" y="1040" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="nota" value="&lt;b&gt;Configuración para 8K (7680 × 4320)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Bloque 16 × 16 = 256 hilos&lt;br&gt;• Grid = 480 × 270 = 129 600 bloques&lt;br&gt;• 33 177 600 hilos: uno por píxel&lt;br&gt;&lt;br&gt;• El if del kernel descarta los hilos que&lt;br&gt;&amp;nbsp;&amp;nbsp;caen fuera de la imagen cuando W o H&lt;br&gt;&amp;nbsp;&amp;nbsp;no son múltiplos de 16.&lt;br&gt;&lt;br&gt;• t_CPU viene de la versión secuencial." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
